{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend",
      "runtimeExecutable": "./target/release/server",
      "runtimeArgs": [
        "--web",
        "web/dist",
        "--fonts",
        "data/fonts",
        "--port",
        "7311"
      ],
      "port": 7311
    },
    {
      "name": "web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--dir",
        "web",
        "run",
        "dev"
      ],
      "port": 5173
    },
    {
      "name": "devtools",
      "url": "http://mac-mini-de-brandon:8077"
    },
    {
      "name": "devtools-dev",
      "runtimeExecutable": "zsh",
      "runtimeArgs": [
        "-c",
        "d=${TMPDIR:-/tmp}/scenic-devtools; mkdir -p $d && exec node tools/devtools/server.mjs --port 8078 --data $d"
      ],
      "port": 8078
    }
  ]
}
