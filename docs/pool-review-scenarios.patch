+//! REVIEW scenarios (not part of the change): each shows a finding of the review on the in-memory
+//! NAS, or a wrapper of it with one fault.
+
+use super::journal::{self, Entry, LeaseId};
+use super::nas::{Mem, Nas};
+use super::records::{self, Records};
+use super::term::{self, Current};
+use super::Member;
+use crate::handoff::Handoff;
+use anyhow::{bail, Result};
+use std::cell::Cell;
+
+const DAY: u64 = 1_791_300_000;
+
+fn built(term: u64, n: u64, t: &str, k: &str, at: u64) -> Entry {
+    let content = format!("base/{t}.{k}.base");
+    let h = Handoff { changes: [(format!("base/{t}"), Some(content.clone()))].into(), pending: [(content, "sha".into())].into(), done: Some(("unit".into(), vec![(t.into(), k.into())])), ..Default::default() };
+    Entry { member: "m-000000000000000c".into(), lease: LeaseId { term, n }, step: "unit".into(), handoff: h, at }
+}
+
+fn any(_: &Entry, _: &Records) -> std::result::Result<(), String> {
+    Ok(())
+}
+
+fn mac(id: &str, host: &str) -> Member {
+    Member { id: id.into(), host: host.into(), app: "development".into() }
+}
+
+/// A corrupt entry's time panics whoever reads it: the merge, the take-up's replay.
+#[test]
+fn review_a_corrupt_entry_time_panics_the_reader() {
+    let nas = Mem::default();
+    let key = journal::write(&nas, &built(1, 1, "6-1-1", "k1", DAY)).unwrap();
+    let mut v: serde_json::Value = serde_json::from_slice(&nas.read(&journal::path(&key)).unwrap().unwrap()).unwrap();
+    v["at"] = serde_json::json!(u64::MAX);
+    nas.write_whole(&journal::path(&key), &serde_json::to_vec(&v).unwrap()).unwrap();
+    let r = std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| {
+        let mut rec = Records { term: 2, ..Default::default() };
+        records::merge(&nas, &mut rec, std::slice::from_ref(&key), &any)
+    }));
+    assert!(r.is_err(), "the merge panicked on a journal entry's `at`");
+}
+
+/// A stale lead's refusal (its own check: say, it leased the targets again after the lease lapsed,
+/// or its app's write-sets are older) sets the entry aside, and the current lead, whose check would
+/// take it, refuses it unread.
+#[test]
+fn review_a_stale_leads_refusal_binds_the_current_lead() {
+    let nas = Mem::default();
+    let (a, b) = (mac("m-000000000000000a", "Mac-mini"), mac("m-000000000000000b", "MacBook-Air"));
+    let t1 = term::bootstrap(&nas, &a, DAY, false).unwrap().unwrap();
+    let mut r1 = records::take_up(&nas, &t1, None, None, &any).unwrap().records;
+    let t2 = term::claim(&nas, &Current { term: 1, lead: Some(t1) }, &b, "taken over by MacBook-Air", DAY + 700).unwrap().unwrap();
+    let mut r2 = records::take_up(&nas, &t2, None, None, &any).unwrap().records;
+    // Its member, still on term 1, tells A of it; A, not yet knowing of term 2, refuses it.
+    let x = journal::write(&nas, &built(1, 5, "6-1-1", "k5", DAY + 710)).unwrap();
+    let a_check = |_: &Entry, _: &Records| Err::<(), String>("6-1-1 leased again since".into());
+    let m = records::merge(&nas, &mut r1, std::slice::from_ref(&x), &a_check);
+    r1.save(&nas).unwrap();
+    for (k, why) in &m.refused {
+        journal::set_aside(&nas, k, why).unwrap();
+    }
+    // Its member learns of term 2 and tells B, whose check takes anything.
+    let m2 = records::merge(&nas, &mut r2, std::slice::from_ref(&x), &any);
+    assert!(m2.applied.is_empty() && m2.refused.len() == 1, "{m2:?}");
+    assert!(!r2.keys.unit.contains_key("6-1-1"));
+}
+
+/// Replays and re-tellings apply an older lease's entry over a newer one's: lease order holds only
+/// within one merge.
+#[test]
+fn review_an_older_lease_replayed_after_a_newer_one_wins() {
+    let nas = Mem::default();
+    let mut r = Records { term: 3, ..Default::default() };
+    let newer = journal::write(&nas, &built(3, 9, "6-1-1", "k9", DAY)).unwrap();
+    let older = journal::write(&nas, &built(3, 5, "6-1-1", "k5", DAY)).unwrap();
+    records::merge(&nas, &mut r, std::slice::from_ref(&newer), &any);
+    records::merge(&nas, &mut r, std::slice::from_ref(&older), &any);
+    assert_eq!(r.keys.unit.get("6-1-1").map(String::as_str), Some("k5"), "the older lease's key");
+    assert_eq!(r.manifest.get("base/6-1-1").map(String::as_str), Some("base/6-1-1.k5.base"));
+}
+
+/// A NAS whose next create makes the file and then fails before its bytes (the share went away
+/// between the two).
+#[derive(Default)]
+struct CutCreate {
+    mem: Mem,
+    cut: Cell<bool>,
+    lost_answer: Cell<bool>,
+}
+
+impl Nas for CutCreate {
+    fn create_new(&self, path: &str, bytes: &[u8]) -> Result<bool> {
+        if self.cut.replace(false) {
+            self.mem.create_new(path, b"")?;
+            bail!("write {path} (made, and left short)");
+        }
+        if self.lost_answer.replace(false) {
+            self.mem.create_new(path, bytes)?;
+            bail!("create {path}: the answer was lost");
+        }
+        self.mem.create_new(path, bytes)
+    }
+    fn write_whole(&self, path: &str, bytes: &[u8]) -> Result<()> {
+        self.mem.write_whole(path, bytes)
+    }
+    fn read(&self, path: &str) -> Result<Option<Vec<u8>>> {
+        self.mem.read(path)
+    }
+    fn exists(&self, path: &str) -> Result<bool> {
+        self.mem.exists(path)
+    }
+    fn list(&self, dir: &str) -> Result<Vec<String>> {
+        self.mem.list(dir)
+    }
+    fn remove(&self, path: &str) -> Result<()> {
+        self.mem.remove(path)
+    }
+}
+
+/// A lead re-asserting as the NAS comes back (what a gap is): its create made term 2, its bytes
+/// failed. Its next try reads the term as another's; nobody may follow it without the owner's force.
+#[test]
+fn review_a_create_cut_short_leaves_no_lead_until_forced() {
+    let nas = CutCreate::default();
+    let (a, b) = (mac("m-000000000000000a", "Mac-mini"), mac("m-000000000000000b", "MacBook-Air"));
+    let t1 = term::bootstrap(&nas, &a, DAY, false).unwrap().unwrap();
+    let cur = Current { term: 1, lead: Some(t1) };
+    nas.cut.set(true);
+    assert!(term::claim(&nas, &cur, &a, "re-asserted after a gap", DAY + 100).is_err());
+    assert_eq!(term::claim(&nas, &cur, &a, "re-asserted after a gap", DAY + 130).unwrap(), None, "its own term, read as another's");
+    let now = term::current(&nas).unwrap();
+    assert_eq!(now, Current { term: 2, lead: None });
+    assert!(term::claim(&nas, &now, &a, "re-asserted after a gap", DAY + 160).is_err());
+    assert!(term::claim(&nas, &now, &b, "taken over by MacBook-Air", DAY + 900).is_err());
+    assert!(term::force(&nas, &now, &b, "taken over by MacBook-Air", DAY + 900).unwrap().is_some());
+}
+
+/// The create made the term whole and its answer was lost: the retry, a moment later, reads the
+/// Mac's own term as another's (the bytes differ by `since`).
+#[test]
+fn review_a_retried_claim_disowns_its_own_term() {
+    let nas = CutCreate::default();
+    let a = mac("m-000000000000000a", "Mac-mini");
+    let t1 = term::bootstrap(&nas, &a, DAY, false).unwrap().unwrap();
+    let cur = Current { term: 1, lead: Some(t1) };
+    nas.lost_answer.set(true);
+    assert!(term::claim(&nas, &cur, &a, "re-asserted after a gap", DAY + 100).is_err());
+    assert_eq!(term::claim(&nas, &cur, &a, "re-asserted after a gap", DAY + 130).unwrap(), None);
+    assert_eq!(term::read(&nas, 2).unwrap().map(|t| t.member), Some(a.id.clone()), "yet term 2 names it");
+}
+
+/// A member back after more than a week tells of an entry whose day GC removed and the records
+/// forgot: it waits forever, and a lead that settles only with nothing waiting never hands over.
+#[test]
+fn review_a_forgotten_entry_waits_forever() {
+    let nas = Mem::default();
+    let mut r = Records { term: 4, ..Default::default() };
+    let x = journal::write(&nas, &built(4, 1, "6-1-1", "k1", DAY)).unwrap();
+    records::merge(&nas, &mut r, std::slice::from_ref(&x), &any);
+    // A week on: GC removes the day, the records forget it; the member was away and didn't.
+    nas.remove(&journal::path(&x)).unwrap();
+    r.forget_before("2026-10-14");
+    for _ in 0..3 {
+        let m = records::merge(&nas, &mut r, std::slice::from_ref(&x), &any);
+        assert_eq!(m.waiting, [x.clone()]);
+    }
+}
+
+/// An entry read while it's being written in more than one piece, a later piece landed first:
+/// a hole of zeros, not a short file. It's refused for good, and set aside (removed) while its
+/// member still writes it.
+#[test]
+fn review_an_entry_read_with_a_hole_is_refused_for_good() {
+    let nas = Mem::default();
+    let e = built(4, 2, "6-1-2", "k2", DAY);
+    let whole = serde_json::to_vec(&e).unwrap();
+    let mut holed = whole.clone();
+    for b in &mut holed[10..30] {
+        *b = 0;
+    }
+    nas.create_new(&journal::path(&e.key()), &holed).unwrap();
+    assert!(matches!(journal::read(&nas, &e.key()).unwrap(), journal::Read::Damaged(_)));
+    let mut r = Records { term: 4, ..Default::default() };
+    let m = records::merge(&nas, &mut r, &[e.key()], &any);
+    assert_eq!(m.refused.len(), 1);
+    // The member's write, once landed, can't undo it: its next try finds another entry there.
+    journal::set_aside(&nas, &e.key(), &m.refused[0].1).unwrap();
+    assert!(matches!(journal::read(&nas, &e.key()).unwrap(), journal::Read::SetAside(_)));
+}
+
+/// Handed to a Mac on a newer app (what the app rule asks for), which then doesn't take up: the
+/// take-back is refused by the app rule, and so is every older Mac's takeover, forced or not. No
+/// lead until a Mac is updated or the target comes back.
+#[test]
+fn review_a_take_back_from_a_newer_app_is_refused_and_so_is_force() {
+    let nas = Mem::default();
+    let a = Member { id: "m-000000000000000a".into(), host: "Mac-mini".into(), app: "20261005-2202-61eb22c".into() };
+    let b = Member { id: "m-000000000000000b".into(), host: "MacBook-Air".into(), app: "20261006-0900-1a2b3c4".into() };
+    let t1 = term::bootstrap(&nas, &a, DAY, false).unwrap().unwrap();
+    let r = records::take_up(&nas, &t1, None, None, &any).unwrap().records;
+    let mut t2 = super::term::Term::after(&Current { term: 1, lead: Some(t1) }, &b, "handed over by Mac-mini", DAY + 60).unwrap();
+    t2.seq = Some(r.seq);
+    assert!(term::make(&nas, &t2).unwrap());
+    // B's lid closes before it takes up; two minutes on, A takes the lead back:
+    let cur = term::current(&nas).unwrap();
+    let back = term::claim(&nas, &cur, &a, "taken back: MacBook-Air didn't take up", DAY + 200);
+    eprintln!("take-back: {:?}", back.as_ref().map_err(|e| e.to_string()));
+    assert!(back.is_err());
+    assert!(term::force(&nas, &cur, &a, "taken over by Mac-mini", DAY + 900).is_err());
+}
