+/// REVIEW: every seed of a range runs the same twice (traces, what went wrong, counts).
+#[test]
+#[ignore]
+fn review_determinism_over_many_seeds() {
+    let var = |v: &str, or: u64| std::env::var(v).ok().and_then(|s| s.parse().ok()).unwrap_or(or);
+    let n = var("REVIEW_SEEDS", 400);
+    let mut diff = Vec::new();
+    for seed in 0..n {
+        let (a, b) = (run(seed, Cfg::pool(), true), run(seed, Cfg::pool(), true));
+        if a.trace != b.trace || a.wrong != b.wrong || a.counts != b.counts {
+            let at = a.trace.iter().zip(&b.trace).position(|(x, y)| x != y);
+            diff.push((seed, a.trace.len(), b.trace.len(), at, a.counts == b.counts));
+        }
+    }
+    eprintln!("{} of {n} seeds differ between two runs: {diff:?}", diff.len());
+}
