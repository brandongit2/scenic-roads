<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>local.scenic.taskboard</string>
  <key>ProgramArguments</key><array>
    <string>@NODE@</string><string>@BOARD@/server.mjs</string>
    <string>--host</string><string>::</string><string>--port</string><string>8077</string>
  </array>
  <key>WorkingDirectory</key><string>@BOARD@</string>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>@HOME@/Library/Logs/scenic/taskboard.log</string>
  <key>StandardErrorPath</key><string>@HOME@/Library/Logs/scenic/taskboard.log</string>
</dict></plist>
