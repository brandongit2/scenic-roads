#!/bin/zsh
# cargo for agent worktrees (#915): every worktree under .claude/worktrees/ on this Mac builds into
# one shared folder, ~/Library/Caches/scenic-target (SCENIC_SHARED_TARGET overrides), so third-party
# crates and unchanged code compile once per Mac, not once per worktree (11-17 GB each before).
# On the PATH of agents' shells through CLAUDE_ENV_FILE (tools/dev/agent-env.zsh) and check.sh.
#
# One build at a time in that folder: a lock (zsystem flock, an fcntl lock) taken before cargo
# starts. A second one prints that it is waiting, for whom, and again every minute (also to
# $SCENIC_CARGO_SAY: check.sh's terminal). This is the point on a 16 GB laptop: two heavy rustc at
# once restarted the M1 (31 Oct). (Cargo's own build-folder lock would serialize only the compile.)
#
# Programs run outside the lock (#937): `cargo run`, `test` and `bench` build under it with this
# script as cargo's target runner, which only records each program cargo would start (its path,
# arguments, environment and folder); the lock goes, then they run from APFS clones in
# $t/.scenic-runs/<pid>/, so another worktree's build can't replace them under a run. `cargo
# nextest run` gets the runner too: it clones each test binary as nextest lists it (still under
# the lock) and runs the clone; the lock goes when the first test starts. A test binary that names
# a program of the shared folder (a CARGO_BIN_EXE_* path, compiled in) runs under the lock: that
# path can't be redirected to a clone (the CARGO_BIN_EXE_* set as a test runs are: they name clones).
# A program for another target than this Mac's (wasm32) has no runner of ours: cargo runs it under
# the lock, as before. A signal to this shell goes on to the cargo or program it waits for (fwd).
#
# Correctness: cargo judges a workspace crate fresh by mtimes, and a crate's artifact names don't
# depend on the checkout's path, so a build of worktree A would pass as fresh for worktree B's older
# sources (seen on a toy workspace, 18 Oct). So when the last build in the folder came from another
# worktree, the workspace crates' fingerprints are deleted first (under the lock): cargo then runs
# rustc for them again, whose incremental state (checked by content hashes) reuses what is the same.
# Third-party crates are untouched: their names hash their version, source and features.
#
# Passed straight to cargo: outside .claude/worktrees/, inside a cargo this shim started under the
# lock (SCENIC_CARGO_SHARED set: a build script's cargo), and commands that never build.
setopt extendedglob
zmodload zsh/system
self=${0:A}

# --- As cargo's target runner (set below): `cargo --scenic-record|--scenic-nextest <dir> <env>
# <program> <args>…`, started by /bin/sh, which first writes cargo's environment to <env>: zsh drops
# a variable whose name isn't a parameter's (CARGO_BIN_EXE_scenic-build), so programs get <env>, not
# this shell's environment. (Cargo's DYLD_FALLBACK_LIBRARY_PATH never reaches it: macOS drops DYLD_*
# when it starts /bin/sh. The workspace's programs load only the system's libraries: otool -L.)
readz() { local x; reply=(); while IFS= read -r -d '' x; do reply+=( "$x" ); done < $1 }
clone() {  # clone <program> <dir>: an APFS clone of it in <dir> (made once, atomically), printed
  # (In a folder named as its own is, so a test binary's clone is still in `deps`, which
  # store::spawn::in_test_program reads: in bin/ alone, a test could listen on a live pool port.)
  local c=$2/${1:h:t}/${1:t}
  mkdir -p ${c:h} || return 1
  [[ -e $c ]] || { cp -c $1 $c.$$ && mv -f $c.$$ $c } || return 1
  print -r -- $c
}
pinned() {  # pinned <test binary>: does it name a program of its profile's folder (CARGO_BIN_EXE_*)?
  local up=${1:h}; [[ ${up:t} == deps ]] && up=${up:h}
  local progs=( $up/*(N.x) )
  # (The folder alone first: one string is searched faster than the list, and most binaries lack it.)
  (( $#progs )) && LC_ALL=C grep -qaF -- $up/ $1 && print -rl -- $progs | LC_ALL=C grep -qaFf /dev/stdin $1
}
if [[ ${1:-} == --scenic-(record|nextest) ]]; then
  mode=${1#--scenic-} dir=$2 e=$3; shift 3
  readz $e; vars=( "${reply[@]}" ); rm -f $e
  # Not built in the shared folder (rustdoc's doctests, in a temp folder): run it now.
  [[ $1 == ${CARGO_TARGET_DIR:-/nonexistent}/* ]] || exec /usr/bin/env -i "${vars[@]}" "$@"
  if [[ $mode == record ]]; then  # cargo run/test/bench: one record a program, in cargo's order
    n=( $dir/*.cwd(N) ); n=$dir/$(( $#n + 1000 ))  # (sortable names: cargo starts them one by one)
    print -rN -- "$@" > $n.argv && print -rN -- "${vars[@]}" > $n.env && print -rn -- $PWD > $n.cwd || exit 1
    exit 0
  fi
  # nextest: it lists every binary (`--list`) before it runs any test, so every one is cloned and
  # checked under the lock, with the programs its CARGO_BIN_EXE_* name (set as it lists and as it
  # runs: the clones made while listing are the ones run); the first test run lets the lock go.
  c=$(clone $1 $dir/bin) || exit 1
  for (( i = 1; i <= $#vars; i++ )); do
    [[ $vars[i] == CARGO_BIN_EXE_[^=]##=$CARGO_TARGET_DIR/* ]] || continue
    x=$(clone ${vars[i]#*=} $dir/bin) || exit 1; vars[i]=${vars[i]%%=*}=$x
  done
  if (( ${@[(I)--list]} )); then pinned $1 && : >> $dir/pinned
  else
    : >> $dir/started
    # (Outside the lock: a cargo it starts takes it.)
    [[ -e $dir/pinned ]] || vars=( ${vars:#SCENIC_CARGO_SHARED=*} )
  fi
  shift; exec /usr/bin/env -i "${vars[@]}" $c "$@"
fi

real=
# (Not another checkout's shim either: with the main checkout's and a worktree's both on the PATH, a
# command passed straight through had each exec the other for ever, 4 Nov.)
for c in $(whence -ap cargo); do [[ ${c:A} == ($self|*/tools/dev/bin/cargo) ]] || { real=$c; break; }; done
[[ -n $real ]] || { print -u2 "cargo (tools/dev/bin): no other cargo on the PATH"; exit 127; }
top=$PWD; while [[ $top != / && ! -e $top/.git ]]; do top=${top:h}; done  # the checkout (a worktree's .git is a file)
[[ -z ${SCENIC_CARGO_SHARED:-} && $top == */.claude/worktrees/* ]] || exec $real "$@"
args=( "$@" ); si=0
for (( i = 1; i <= $#args; i++ )); do [[ $args[i] == [+-]* ]] || { si=$i; break; }; done
sub=${args[si]:-}
case $sub in
  ''|fmt|metadata|locate-project|pkgid|tree|help|verify-project|read-manifest|search|version) exec $real "$@" ;;
esac
t=${SCENIC_SHARED_TARGET:-$HOME/Library/Caches/scenic-target}
mkdir -p $t || exit 1
lock=$t/.scenic-lock
: >> $lock || exit 1
# (-e: the lock stays held across exec, for the commands cargo runs whole under it.)
if ! zsystem flock -e -t 0 -f fd $lock 2>/dev/null; then
  start=$SECONDS
  say() { print -u2 -r -- "$1"; [[ -n ${SCENIC_CARGO_SAY:-} ]] && print -r -- "    $1" >> $SCENIC_CARGO_SAY 2>/dev/null; }
  while say "cargo: waiting for the shared build folder $t ($(( SECONDS - start )) s; held by: $(cat $t/.scenic-holder 2>/dev/null || print unknown))"
        ! zsystem flock -e -t 60 -f fd $lock 2>/dev/null; do :; done
  say "cargo: got the shared build folder after $(( SECONDS - start )) s"
fi
print -r -- "${top:t} pid $$ since $(date '+%T'): cargo $*" > $t/.scenic-holder
if [[ $(cat $t/.scenic-built-by 2>/dev/null) != $top ]]; then
  # The workspace's package and target names (- and _ forms): their fingerprints go.
  names=( ${(f)"$($real metadata --no-deps --format-version 1 --offline 2>/dev/null | python3 -c '
import json, sys
for p in json.load(sys.stdin)["packages"]:
    for n in [p["name"]] + [t["name"] for t in p["targets"]]: print(n); print(n.replace("-", "_"))')"} )
  if (( ! $#names )); then print -u2 "cargo: could not list the workspace's crates"; exit 1; fi
  typeset -A ws; for n in $names; do ws[$n]=1; done
  for f in $t/*/.fingerprint/*(DN/) $t/*/*/.fingerprint/*(DN/); do  # <profile>/ and <triple>/<profile>/
    n=${f:t}; (( ${+ws[${n%-[0-9a-f](#c16)}]} )) && rm -rf $f
  done
  print -r -- $top > $t/.scenic-built-by
fi
# The checkout's tools (cmake for crates/geos-src) by PATH, not by mise's shims: build scripts run in
# the shared folder, outside the repo, where a shim finds no mise.toml.
whence mise >/dev/null && eval "$(mise env -C $top -s zsh 2>/dev/null)" 2>/dev/null
export CARGO_TARGET_DIR=$t SCENIC_CARGO_SHARED=1

# Which commands run programs: run, test, bench (and their aliases), nextest's run.
ri=0
case $sub in
  run|r|test|t|bench) ri=$si ;;
  nextest) for (( i = si + 1; i <= $#args; i++ )); do [[ $args[i] == [+-]* ]] || break; done
           [[ ${args[i]:-} == (run|r) ]] && ri=$i ;;
esac
(( ri )) || exec $real "$@"
host=$(rustc -vV 2>/dev/null | sed -n 's/^host: //p')
[[ -n $host ]] || exec $real "$@"
# This run's clones, in the shared folder (an APFS clone is a copy only on the same volume). Those
# of runs whose process is gone go first (a program exec'd below leaves its folder behind).
runs=$t/.scenic-runs
for d in $runs/<->(N/); do kill -0 ${d:t} 2>/dev/null || rm -rf $d; done
r=$runs/$$; rm -rf $r; mkdir -p $r/bin || exit 1
mode=record; [[ $sub == nextest ]] && mode=nextest
# (The runner: /bin/sh writes the environment to a file in $r, then starts this script on it.)
sh='m=$1 d=$2; shift 2; e=$(/usr/bin/mktemp "$d/env.XXXXXX") && /usr/bin/env -0 > "$e" && exec /bin/zsh "$0" "$m" "$d" "$e" "$@"'
args=( "${(@)args[1,ri]}" --config "target.$host.runner = [\"/bin/sh\", \"-c\", '$sh', \"$self\", \"--scenic-$mode\", \"$r\"]" "${(@)args[ri+1,-1]}" )
unlock() { zsystem flock -u $fd }
# Cargo, and each program run here, is a child this shell waits for: a signal to this shell (a kill
# of the pid ps shows as cargo) goes on to it, and the shell and its lock outlive it. (Killed while
# its cargo built, the shell let the lock go with that build still running.)
child=0 sig=0
fwd() { sig=$1; (( child )) && kill -$1 $child 2>/dev/null; (( child )) || { rm -rf $r; exit $(( 128 + $1 )) } }
trap 'fwd 1' HUP; trap 'fwd 2' INT; trap 'fwd 15' TERM
waitchild() {  # the child's status, once it is gone (a trapped signal ends a wait early)
  local s; while :; do wait $child; s=$?; kill -0 $child 2>/dev/null || break; done
  child=0; return $s
}
stopped() { (( sig )) && { rm -rf $r; exit $(( $1 ? $1 : 128 + sig )) } }

if [[ $mode == nextest ]]; then
  # Nextest builds, lists every binary (each cloned by the runner), then runs tests from the clones.
  zmodload zsh/zselect
  $real "${args[@]}" <&0 & child=$!
  while kill -0 $child 2>/dev/null && [[ ! -e $r/started ]]; do zselect -t 20; done
  [[ -e $r/pinned ]] || unlock  # (a binary naming the shared folder's programs: the lock to the end)
  waitchild; rc=$?
  rm -rf $r
  exit $rc
fi

$real "${args[@]}" <&0 & child=$!; waitchild; rc=$?
stopped $rc
recs=( $r/*.cwd(N) ); recs=( ${recs%.cwd} )
if (( ! $#recs )); then rm -rf $r; exit $rc; fi
# As cargo: stop at the first failure unless --no-fail-fast; -q: no "Running" lines. (Only the
# options before `--`: after it they are the programs'.)
own=( "${(@)args[1,${args[(i)--]}-1]}" )
nff=${own[(I)--no-fail-fast]} quiet=$(( ${own[(I)-q]} + ${own[(I)--quiet]} ))
prog() {  # prog <record> <clone> <keep SCENIC_CARGO_SHARED>: the program as cargo would start it
  local args vars
  readz $1.argv; args=( "${reply[@]}" )
  readz $1.env; vars=( "${reply[@]}" )
  # (Outside the lock a cargo it starts must take the lock again.)
  (( $3 )) || vars=( ${vars:#SCENIC_CARGO_SHARED=*} )
  cd -- "$(<$1.cwd)" || return 1
  exec /usr/bin/env -i "${vars[@]}" $2 "${(@)args[2,-1]}"
}
binexe() {  # binexe <record>: its CARGO_BIN_EXE_* (cargo sets them as it runs a test too) name clones
  local i x vars; readz $1.env; vars=( "${reply[@]}" )
  for (( i = 1; i <= $#vars; i++ )); do
    [[ $vars[i] == CARGO_BIN_EXE_[^=]##=$t/* ]] || continue
    x=$(clone ${vars[i]#*=} $r/bin) || return 1; vars[i]=${vars[i]%%=*}=$x
  done
  print -rN -- "${vars[@]}" > $1.env
}
runprog() {  # runprog <record> <keep SCENIC_CARGO_SHARED>: the program as a child (see fwd), its status
  ( prog $1 $cl[$1] $2 ) <&0 & child=$!; waitchild
}
exe() { readz $1.argv; print -r -- $reply[1] }
started() { (( quiet )) || print -u2 -r -- "     Running ${$(exe $1)#$t/}$2" }
failed() { print -u2 -r -- "error: test failed: ${$(exe $1)#$t/} (exit $2)" }
# Clones first, under the lock: a run's program with the programs beside it (which it may start from
# its own folder), a test's with the programs its CARGO_BIN_EXE_* name. A test binary naming the
# shared folder's programs in its code (env!) runs now, under the lock.
typeset -A cl; first=0; later=()
for rec in $recs; do
  x=$(exe $rec)
  if [[ $sub == (run|r) ]]; then
    for p in ${x:h}/*(N.x); do [[ $p == $x ]] || clone $p $r/bin >/dev/null; done
  fi
  cl[$rec]=$(clone $x $r/bin) && binexe $rec || { print -u2 "cargo: could not clone $x into $r/bin"; rm -rf $r; exit 1; }
  if [[ $sub != (run|r) ]] && pinned $x; then
    started $rec " (under the build lock: it names the shared folder's programs)"
    runprog $rec 1; x=$?
    stopped $x
    if (( x )); then
      failed $rec $x; (( first )) || first=$x
      (( nff )) || { rm -rf $r; exit $x; }
    fi
  else later+=( $rec ); fi
done
unlock
for (( i = 1; i <= $#later; i++ )); do
  rec=$later[i]
  started $rec
  # The last one replaces this shell, so signals reach it as they reach cargo run's program (its
  # clones stay until the next run here sweeps them); not when an earlier failure decides the status.
  if (( i == $#later && ! first && ! rc )); then
    if [[ $sub != (run|r) ]]; then
      readz $rec.env; keep=( $cl[$rec] ${${(M)reply:#CARGO_BIN_EXE_*}#*=} )
      for p in $r/bin/*/*(N); do (( $keep[(Ie)$p] )) || rm -f $p; done
    fi
    prog $rec $cl[$rec] 0; exit 1
  fi
  runprog $rec 0; x=$?
  stopped $x
  if (( x )); then
    failed $rec $x; (( first )) || first=$x
    (( nff )) || break
  fi
done
rm -rf $r
(( first )) && exit $first
exit $rc
