#!/bin/zsh
# cargo for agent worktrees (#915): every worktree under .claude/worktrees/ on this Mac builds into
# one shared folder, ~/Library/Caches/scenic-target (SCENIC_SHARED_TARGET overrides), so third-party
# crates and unchanged code compile once per Mac, not once per worktree (11-17 GB each before).
# On the PATH of agents' shells through CLAUDE_ENV_FILE (tools/dev/agent-env.zsh) and check.sh.
#
# One build at a time in that folder: a lock (zsystem flock, an fcntl lock) taken before cargo
# starts and let go when it ends (cargo runs as this shell's child). This is the point on a 16 GB
# laptop: two heavy rustc at once restarted the M1 (31 Oct). (Cargo's own build-folder lock would
# serialize only the compile.) Waiters take the lock in arrival order (take: a ticket queue), and
# print that they wait, their place and for whom, then every minute (also to $SCENIC_CARGO_SAY:
# check.sh's terminal); once the hold is longer than most (report), what the holder is doing.
#
# Programs run outside the lock (#937): `cargo run`, `test` and `bench` build under it with this
# script as cargo's target runner, which only records each program cargo would start (its path,
# arguments, environment and folder); the lock goes, then they run from APFS clones in
# $t/.scenic-runs/<pid>/, so another worktree's build can't replace them under a run (kept 10 min
# after it, #1131: tools/dev/testing.md, "A program that ran is kept 10 minutes"). `cargo
# nextest run` gets the runner too: it clones each test binary as nextest lists it (still under
# the lock) and runs the clone; the lock goes when the first test starts (#1108: never later; a
# hung test held it 35 min). The CARGO_BIN_EXE_* set as a test runs name clones; a test reads its
# program's path from them, never env!'s compiled-in path (tools/app/guards.sh refuses that).
# A program for another target than this Mac's (wasm32) has no runner of ours: cargo runs it under
# the lock, as before. A signal to this shell goes on to the cargo or program it waits for (fwd).
#
# Shared across worktrees (#1123): a workspace crate's artifact names don't depend on the checkout's
# path, so worktree B can use what worktree A built. Cargo judges a crate fresh by its sources'
# checksums here (-Z checksum-freshness, below), not their times: B's crate is fresh when its
# sources are the bytes A built (by times, a fresh worktree's files are newer than every build, and
# B's older sources passed for A's build: until #1123 every workspace crate compiled again after
# another worktree's build). Cargo checks only paths it holds relative to the package, so a unit
# whose record names another checkout's files is tied to it: one compiling in a file outside its
# package (include_str! of web/, by its full path: cargo would check A's copy) that differs from
# this checkout's, one built with a variable naming another checkout (env!("CARGO_MANIFEST_DIR"),
# which cargo doesn't check: a test reads that path as it runs, store::testkit), a build script's
# output naming one, a build script watching files by rerun-if-changed (judged by time, not bytes),
# or one built without checksums (by an older shim, or a cargo not honouring the flag: then all
# are). So when the last build in the folder came from another checkout, those units' fingerprints
# (and a build script run's output) are deleted first (under the lock; .scenic-tied lists them,
# with why): they and the units using them compile again. Third-party crates are untouched: their
# names hash their version, source and features.
#
# Each cargo that builds is recorded for the dev job dashboard (tools/dev/devjob.zsh): its wait for
# the lock, the build (each crate compiled, from cargo's --timings report, which it adds), each
# program it runs (a test binary as a suite); a measurement (an example, a release run) or a backtest
# (--replay, a backtest test) said so. Outside .claude/worktrees/ (the main checkout) cargo builds
# as it would, in its own folder without the lock, as this shell's child so its run is recorded.
#
# Passed straight to cargo: inside a cargo this shim started under the lock (SCENIC_CARGO_SHARED
# set: a build script's cargo), and commands that never build (reads).
setopt extendedglob
zmodload zsh/system zsh/datetime zsh/zselect; zmodload -F zsh/stat b:zstat
self=${0:A}

# --- As cargo's target runner (set below): `cargo --scenic-record|--scenic-nextest <dir> <env>
# <program> <args>…`, started by /bin/sh, which first writes cargo's environment to <env>: zsh drops
# a variable whose name isn't a parameter's (CARGO_BIN_EXE_scenic-build), so programs get <env>, not
# this shell's environment. (Cargo's DYLD_FALLBACK_LIBRARY_PATH never reaches it: macOS drops DYLD_*
# when it starts /bin/sh. The workspace's programs load only the system's libraries: otool -L.)
readz() { local x; reply=(); while IFS= read -r -d '' x; do reply+=( "$x" ); done < $1 }
clone() {  # clone <program> <dir>: an APFS clone of it in <dir> (made once, atomically), printed
  # (In a folder named as its own is, so a test binary's clone is still in `deps`, which
  # store::spawn::in_test_program reads: in bin/ alone, a test could listen on a live pool port.)
  local c=$2/${1:h:t}/${1:t}
  mkdir -p ${c:h} || return 1
  [[ -e $c ]] || { cp -c $1 $c.$$ && mv -f $c.$$ $c } || return 1
  print -r -- $c
}
if [[ ${1:-} == --scenic-(record|nextest) ]]; then
  mode=${1#--scenic-} dir=$2 e=$3; shift 3
  readz $e; vars=( "${reply[@]}" ); rm -f $e
  # Not built in the shared folder (rustdoc's doctests, in a temp folder): run it now.
  [[ $1 == ${CARGO_TARGET_DIR:-/nonexistent}/* ]] || exec /usr/bin/env -i "${vars[@]}" "$@"
  if [[ $mode == record ]]; then  # cargo run/test/bench: one record a program, in cargo's order
    n=( $dir/*.cwd(N) ); n=$dir/$(( $#n + 1000 ))  # (sortable names: cargo starts them one by one)
    print -rN -- "$@" > $n.argv && print -rN -- "${vars[@]}" > $n.env && print -rn -- $PWD > $n.cwd || exit 1
    exit 0
  fi
  # nextest: it lists every binary (`--list`) before it runs any test, so every one is cloned
  # under the lock, with the programs its CARGO_BIN_EXE_* name (set as it lists and as it runs:
  # the clones made while listing are the ones run); the first test run lets the lock go.
  c=$(clone $1 $dir/bin) || exit 1
  for (( i = 1; i <= $#vars; i++ )); do
    [[ $vars[i] == CARGO_BIN_EXE_[^=]##=$CARGO_TARGET_DIR/* ]] || continue
    x=$(clone ${vars[i]#*=} $dir/bin) || exit 1; vars[i]=${vars[i]%%=*}=$x
  done
  if (( ! ${@[(I)--list]} )); then
    : >> $dir/started
    # (Outside the lock: a cargo it starts takes it.)
    vars=( ${vars:#SCENIC_CARGO_(SHARED|HOLD)=*} )
  fi
  shift; exec /usr/bin/env -i "${vars[@]}" $c "$@"
fi

real=
# (Not another checkout's shim either: with the main checkout's and a worktree's both on the PATH, a
# command passed straight through had each exec the other for ever, 4 Nov.) Nor a mise shim where
# mise has no cargo for this folder (outside a checkout): it runs the first other cargo on the PATH,
# this shim, which ran it again, about 2,900 times (#1108 review).
for c in $(whence -ap cargo); do
  [[ ${c:A} == ($self|*/tools/dev/bin/cargo) ]] && continue
  [[ ${c:A:t} == mise ]] && ! ${c:A} which cargo >/dev/null 2>&1 && continue
  real=$c; break
done
[[ -n $real ]] || { print -u2 "cargo (tools/dev/bin): no other cargo on the PATH"; exit 127; }
top=$PWD; while [[ $top != / && ! -e $top/.git ]]; do top=${top:h}; done  # the checkout (a worktree's .git is a file)
[[ -z ${SCENIC_CARGO_SHARED:-} ]] || exec $real "$@"
inside=0; [[ $top == */.claude/worktrees/* ]] && inside=1
# `cargo --scenic-hold <ready file>` (check.sh, #1123): holds the shared folder for the cargos of
# the process that started it (see "A hold", below), which it names; inside a worktree only.
hold=0
if [[ ${1:-} == --scenic-hold ]]; then
  (( inside )) && [[ -n ${2:-} ]] || { print -u2 "cargo --scenic-hold <ready file>: in an agent worktree"; exit 2; }
  hold=1 ready=$2; set -- hold
fi
args=( "$@" ); si=0
# The subcommand: the first word neither an option nor the value of a cargo option taking one.
for (( i = 1; i <= $#args; i++ )); do
  case $args[i] in
    --color|--config|-C|-Z|--explain) (( i++ )) ;;
    [+-]*) ;;
    *) si=$i; break ;;
  esac
done
sub=${args[si]:-}
own=( "${(@)args[1,${args[(i)--]}-1]}" )  # cargo's own arguments (after `--`, a program's)
# Under the lock, what compiles or writes the shared folder: cargo --list's build commands (fetch
# aside: the registry only), install, package and publish (they build to verify), and the cargo-*
# that build (clippy, miri, nextest). Passed straight, what reads or edits only manifests, the lock
# file, the registry or sources (reads), and any command asking for help or a version. A subcommand
# in neither (another cargo-*, a config's [alias]) is taken as building, saying so.
# (tools/dev/test/shared-target.zsh checks that every built-in of `cargo --list` is in one.)
builds=( b bench build c check clean d doc fix install package publish r report run rustc rustdoc t test clippy miri nextest )
reads=( add config fetch fmt generate-lockfile git-checkout help info init locate-project login logout metadata new owner pkgid read-manifest remove rm search tree uninstall update vendor verify-project version yank )
asks=${own[(I)(-h|--help|-V|--version)]}
(( ! hold )) && { [[ -z $sub ]] || (( $reads[(Ie)$sub] || asks )) } && exec $real "$@"
(( $builds[(Ie)$sub] || ! inside || hold )) || print -u2 -r -- "cargo (tools/dev/bin): \`$sub\` isn't known to build or not: run under the shared build folder's lock"
t=${SCENIC_SHARED_TARGET:-$HOME/Library/Caches/scenic-target}
# (Where cargo writes its timing report: the shared folder, or outside a worktree its own.)
tdir=$t; (( inside )) || tdir=${CARGO_TARGET_DIR:-$top/target}
# The dev job dashboard's span of this cargo (a cargo of its own, or a check's part's), and what it is for.
source ${self:h:h}/devjob.zsh
purpose=
case " $* " in
  *" --replay "*|*backtest*) purpose=backtest ;;
  *" --example "*|*" --example="*) purpose=measurement ;;
  *) [[ $sub == (r|run|bench) ]] && (( ${own[(I)(-r|--release)]} )) && purpose=measurement ;;
esac
name="cargo ${(j: :)own}"; (( hold )) && name="hold the shared build folder (check.sh: clippy, then the tests' build)"
dj_start cargo $name args "$*" checkout ${top:t} ${purpose:+purpose} ${purpose:+$purpose}; djid=$REPLY
# (Its crates' times: cargo's timing report, for the commands that make one; the sampler reads it.)
if [[ -n $djid && $sub == (b|build|c|check|t|test|bench|r|run|clippy|d|doc|rustc|rustdoc) ]] && (( ! ${own[(I)--timings*]} )); then
  args=( "${(@)args[1,si]}" --timings "${(@)args[si+1,-1]}" ); set -- "${args[@]}"
fi
[[ -n $djid ]] && export SCENIC_DEVJOB_PARENT=$djid
djdone() {  # the span ended by how this script exits: 0 ok, by a signal stopped, else fail
  local x=$1 st=ok; (( x )) && st=fail; (( sig )) && st=stopped
  dj_end $djid $st exit $x
}
# Cargo, and each program run here, is a child this shell waits for: a signal to this shell (a kill
# of the pid ps shows as cargo) goes on to it, and the shell and its lock outlive it. (Killed while
# its cargo built, the shell let the lock go with that build still running.) A child of a shell
# without job control starts with SIGINT and SIGQUIT ignored, so a forwarded INT did nothing: spawn
# gives them back.
child=0 sig=0
fwd() { sig=$1; (( child )) && kill -$1 $child 2>/dev/null; (( child )) || exit $(( 128 + $1 )) }
trap 'fwd 1' HUP; trap 'fwd 2' INT; trap 'fwd 15' TERM
spawn() { ( trap - INT QUIT; "$@" ) <&0 & child=$! }  # spawn <function that execs>
realcargo() { exec $real "$@" }
waitchild() {  # the child's status, once it is gone (a trapped signal ends a wait early)
  local s; while :; do wait $child; s=$?; kill -0 $child 2>/dev/null || break; done
  child=0; return $s
}
stopped() { (( sig )) && exit $(( $1 ? $1 : 128 + sig )) }
whole() { spawn realcargo "$@"; waitchild; rc=$?; built $rc; stopped $rc; exit $rc }  # cargo, the lock to its end
built() {  # built <cargo's status>: the build's span, from the lock to cargo's end, and its timing report moved for the sampler
  dj_on && [[ -n $djid ]] || return 0
  local st=ok; (( $1 )) && st=fail; (( sig )) && st=stopped
  dj_span build build $djgot $EPOCHREALTIME $st
  local rep=( $tdir/cargo-timings/cargo-timing-*.html(Nom[1]) ) m
  if (( $#rep )) && zstat -A m +mtime $rep[1] && (( m[1] >= ${djgot%.*} )); then mv -f $rep[1] $DJ_DIR/$REPLY.timings.html; fi
  rm -f $tdir/cargo-timings/cargo-timing.html
}

# Outside a worktree: cargo as it is (its own build folder, no lock), a child only so its run is
# recorded.
if (( ! inside )); then
  trap 'x=$?; djdone $x' EXIT
  djgot=$EPOCHREALTIME
  whole "$@"
fi
mkdir -p $t || exit 1
lock=$t/.scenic-lock holder=$t/.scenic-holder holds=$t/.scenic-holds
: >> $lock || exit 1
me="${top:t} pid $$: cargo $*"
say() { print -u2 -r -- "$1"; [[ -n ${SCENIC_CARGO_SAY:-} ]] && print -r -- "    $1" >> $SCENIC_CARGO_SAY 2>/dev/null; }
# The lock in arrival order. fcntl doesn't queue: zsh's flock -t tries again each second, so a cargo
# waiting an hour lost to each newer one that tried at the right moment (4 Nov). Each cargo takes a
# ticket, .scenic-queue/<n>, n from .scenic-queue/.next (under .scenic-queue/.lock; never reused,
# so a sweep of a gone ticket can't hit a new one), holding an fcntl lock on it while it waits: a
# ticket whose lock can be taken is a gone cargo's, and goes. Only the first live ticket tries the
# build lock, every tick (0.2 s: a turn passes on within it; a try and a listing of the queue cost
# nothing beside a build). The waiting line comes at once and every minute (a waiting terminal
# shows it's alive).
take() {
  local q=$t/.scenic-queue tfd x f n ahead said=0 line=0 due=-1 rh h age; local -a m
  local -F start=$EPOCHREALTIME
  integer waited
  mkdir -p $q && : >> $q/.lock && print -r -- $me > $q/.new.$$ || return 1
  zsystem flock -f tfd $q/.new.$$ && zsystem flock -f x $q/.lock || return 1
  for f in $q/.(new|next).<->(N); do kill -0 ${f##*.} 2>/dev/null || rm -f $f; done  # (a cargo gone as it took one)
  # (Past the last ticket too, and .next replaced whole: a .next emptied by a cargo killed as it
  # wrote it restarted at 1, ahead of the line, and a sweep of a gone 1 could hit the new one.)
  local -a e; e=( $q/<->(Nn) ); integer last=${${e[-1]:-0}:t}
  n=; [[ -r $q/.next ]] && n=$(<$q/.next); [[ $n == <-> ]] || n=0
  (( n = (n > last ? n : last) + 1 )); ticket=$q/$n
  print -r -- $n > $q/.next.$$ && mv -f $q/.next.$$ $q/.next
  mv -f $q/.new.$$ $ticket; zsystem flock -u $x
  holdtimes
  while :; do
    ahead=0
    for f in $q/<->(Nn); do [[ $f == $ticket ]] && break; live $f && (( ahead++ )); done
    (( ! ahead )) && zsystem flock -t 0 -f fd $lock 2>/dev/null && break
    [[ -e $ticket && -e $lock ]] || { say "cargo: the shared build folder's lock or this cargo's ticket is gone ($ticket)"; return 1 }
    (( waited = EPOCHREALTIME - start ))
    if (( waited >= line )); then
      h=$(cat $holder 2>/dev/null) said=1 line=$(( waited + 60 ))
      say "cargo: waiting for the shared build folder $t ($waited s; place $(( ahead + 1 )) in line; held by: ${h:-unknown})"
      [[ $h == $rh ]] || rh=$h due=$thr  # (a new holder: its hold from the start)
      if [[ -n $h ]] && zstat -A m +mtime $holder 2>/dev/null && (( (age = EPOCHSECONDS - m[1]) >= due )); then
        report $h $age; due=$(( 2 * age ))
      fi
    fi
    zselect -t 20
  done
  rm -f $ticket; zsystem flock -u $tfd
  (( waited = EPOCHREALTIME - start ))
  (( said )) && say "cargo: got the shared build folder after $waited s"
  return 0
}
live() {  # live <ticket>: is its cargo still waiting? (A gone cargo's ticket goes.)
  local y
  zsystem flock -t 0 -f y $1 2>/dev/null || { [[ -e $1 ]]; return }
  zsystem flock -u $y; rm -f $1; return 1
}
# The report: once the holder has held the folder longer than nine holds in ten of the last 100
# (.scenic-holds: each hold's seconds, written by the cargo letting go; enough that a few odd holds
# don't move the tenth longest, few enough to follow the workspace as it grows), and again each
# time its hold doubles, the waiting line says what it is doing: its pid, command, processes and
# their CPU. A stuck holder is seen, not killed. (No holds recorded yet: from the first line.)
holdtimes() {
  local -a d; d=( ${(on)${${(f)"$(cat $holds 2>/dev/null)"}%% *}} )
  integer k=$(( (9 * $#d + 9) / 10 ))
  thr=${d[k]:-0} nholds=$#d
}
report() {  # report <holder line> <its age, s>
  local p pid ppid c tm rest ind; local -A kids desc; local -F sum=0
  local of="no holds recorded yet"; (( nholds )) && of="9 holds in 10 of the last $nholds took ≤ $thr s"
  [[ $1 =~ ' pid ([0-9]+) ' ]] && p=$match[1]
  # (The holder's line is the waiting line's, just before.)
  say "cargo: the folder has been held $2 s ($of); its holder, pid ${p:-(none)}:"
  if [[ -z $p ]] || ! kill -0 $p 2>/dev/null; then
    say "  is gone: what holds the lock didn't say who it is"; return
  fi
  ps -A -o pid=,ppid=,%cpu=,time=,command= | while read -r pid ppid c tm rest; do
    kids[$ppid]+=" $pid"; desc[$pid]="$c% cpu, $tm cpu time: $rest"
  done
  ptree() {  # (a rustc line runs to thousands of characters: its first 200 name the crate)
    printf -v ind '%*s' $(( 2 * $2 + 4 )) ''; say "$ind$1 ${desc[$1][1,200]}"
    (( sum += ${${desc[$1]%%\%*}:-0} ))
    local k; for k in ${=kids[$1]}; do ptree $k $(( $2 + 1 )); done
  }
  say "  its processes (pid, %cpu, cpu time, command):"; ptree $p 0
  if (( sum > 0 )); then say "  using CPU: $(printf %.1f $sum)% (ps's %cpu, summed; sccache compiles third-party crates in its own server)"
  else say "  using no CPU: it may be stuck (the shim doesn't kill it; tools/dev/testing.md)"; fi
}
# A hold (#1123): check.sh runs clippy, then the tests' build, as one turn with the folder: a
# `cargo --scenic-hold` started by check.sh takes the lock in line as any cargo, then holds it
# while check.sh lives, its line naming check.sh's pid (whose processes a long hold's report shows)
# and itself, `(hold <pid>)`. A cargo under it (SCENIC_CARGO_HOLD, that pid, exported by check.sh to
# those two parts) builds without taking the lock while the holder's line still names it; at the
# point a cargo would let go (the first test nextest starts, #1108; a test's or run's programs
# cloned), it lets the hold go (USR1), so a long test run holds no one up. Its programs don't get
# SCENIC_CARGO_HOLD: a cargo a test starts takes the lock. remote-tests.sh lets it go when the tests
# run on the test Mac; check.sh when its tests part ends, or when it does.
byhold=
if (( ! hold )) && [[ -n ${SCENIC_CARGO_HOLD:-} && $(cat $holder 2>/dev/null) == *" (hold $SCENIC_CARGO_HOLD)" ]] &&
    [[ $(ps -o command= -p $SCENIC_CARGO_HOLD 2>/dev/null) == *--scenic-hold* ]]; then
  byhold=$SCENIC_CARGO_HOLD
fi
letgo() {  # the folder let go: the hold this cargo ran under, or its own lock
  if [[ -n $byhold ]]; then kill -USR1 $byhold 2>/dev/null; byhold=; else release; fi
}
fd=0 took=0
djt0=$EPOCHREALTIME
(( hold )) && me="${top:t} pid $PPID: check.sh's clippy, then its tests' build (hold $$)"
if [[ -z $byhold ]]; then
  take || exit 1
  djgot=$EPOCHREALTIME
  (( djgot - djt0 >= 0.2 )) && dj_span wait "the shared build folder" $djt0 $djgot ok
  took=$EPOCHSECONDS; print -r -- "${me/: / since $(strftime %T $took): }" > $holder  # (since it holds, not since it waited)
fi
djgot=$EPOCHREALTIME
release() {  # lets the lock go (once), its holder line removed and its hold's time kept
  (( fd )) || return 0
  rm -f $holder
  local -a l; l=( ${(f)"$(cat $holds 2>/dev/null)"} "$(( EPOCHSECONDS - took )) $sub" )
  (( $#l > 100 )) && l=( ${l[-100,-1]} )
  print -rl -- $l > $holds.$$ && mv -f $holds.$$ $holds
  zsystem flock -u $fd; fd=0
}
trap 'x=$?; release; djdone $x' EXIT
if (( hold )); then  # held until let go (USR1), stopped, or check.sh gone
  go=0; trap 'go=1' USR1  # (before the ready file: check.sh may let it go at once)
  : > $ready || exit 1
  while (( ! go )) && kill -0 $PPID 2>/dev/null; do zselect -t 20; done
  dj_span build "held" $djgot $EPOCHREALTIME ok
  exit 0
fi
# The units tied to another checkout (see above) lose their fingerprints, and so compile again:
# look all, when another worktree built last (every workspace unit, by its package and target
# names); look kept, else, the units kept that compile in another checkout's file (.scenic-elsewhere:
# cargo goes on checking that file, not this checkout's, which may change meanwhile). Each unit
# found, with why, goes to .scenic-tied; how many of how many to $REPLY.
look() {  # look all <names>… | look kept
  REPLY=$(python3 - $1 $t $top ${top%%/.claude/worktrees/*} "${@:2}" <<'PY'
import filecmp, glob, os, re, shutil, sys
mode, t, top, main, *names = sys.argv[1:]
# (Without links: rustc names the folder cargo runs in as getcwd gives it, /private/var for /var.)
t, top, main = (os.path.realpath(x) for x in (t, top, main))

def elsewhere(p):
    """p's path in this checkout when p is another checkout's file (the main checkout's, or another
    worktree's under it), else None."""
    if not p.startswith(main + "/"):
        p = os.path.realpath(p)
    if not p.startswith(main + "/") or p.startswith(top + "/") or p.startswith(t + "/"):
        return None
    rest = p[len(main) + 1:]
    if rest.startswith(".claude/worktrees/"):
        parts = rest.split("/", 3)
        return os.path.normpath(parts[3]) if len(parts) == 4 else ""
    return os.path.normpath(rest)

def same(p, rel):
    try:
        return filecmp.cmp(p, os.path.join(top, rel), shallow=False)
    except OSError:
        return False

def records(fp):
    """What rustc and cargo recorded of the unit's inputs: rustc's dep-info (<name>-<hash>.d), a
    build script's output, cargo's own dep-info (the fingerprint's dep-*: what it checks)."""
    d, h = os.path.dirname(os.path.dirname(fp)), fp[-16:]
    return (glob.glob(f"{d}/deps/*-{h}.d") + glob.glob(f"{d}/examples/*-{h}.d") + glob.glob(f"{d}/build/*-{h}/*.d")
            + glob.glob(f"{d}/build/*-{h}/output") + glob.glob(f"{fp}/dep-*"))

def read(f):
    try:
        return open(f, "rb").read().decode("utf-8", "replace")
    except OSError:
        return None

def tied(recs, kept):
    """Why the unit is tied to another checkout, or None; the other checkouts' files it compiles
    in, the same as this one's, added to kept."""
    if not recs:
        return "no record of its inputs"
    for f in recs:
        text = read(f)
        if text is None:
            return "its inputs' record unreadable"
        if f.endswith(".d"):
            # rustc's: its sources' checksums (cargo's -Z checksum-freshness) and the variables it
            # read as it compiled (env!), whose values cargo doesn't check.
            if not re.search(r"^# checksum:", text, re.M):
                return "built without checksums"
            for k, v in re.findall(r"^# env-dep:([^=\n]*)=(.*)$", text, re.M):
                if any(elsewhere(p) is not None for p in re.findall(r"/[^\s:]+", v)):
                    return f"its {k} names another checkout"
        elif os.path.basename(f).startswith("dep-"):
            # cargo's (binary: each path's bytes after their length): a source outside the package
            # by its full path, the one cargo checks.
            for p in re.findall(r"/[^\x00-\x1f\x7f]+", text):
                rel = elsewhere(p)
                if rel is None:
                    continue
                if not same(p, rel):
                    return f"it compiles in another checkout's {rel}, not this one's bytes"
                kept.add((p, rel))
        else:
            # a build script's output. What it watches by `rerun-if-changed` cargo judges by time,
            # not checksums (cargo 1.98 checks only rustc's sources by content): this checkout's
            # copy of a watched file, older than the run, would pass for the one it read.
            if re.search(r"^cargo::?rerun-if-changed=", text, re.M):
                return "its build script watches files by their times (rerun-if-changed)"
            if any(elsewhere(p) is not None for p in re.findall(r"/[^\s:;,=\"']+", text)):
                return "its build script's output names another checkout"
    return None

found, kept, seen = [], [], 0
def drop(fp, why):
    """The unit compiles (or runs) again, and so do the units using it. Cargo passes a unit's
    staleness on to its users by what it finds on disk, not by a fingerprint missing: a compile's
    dep-info goes with its fingerprint's folder, but a build script run's record is its output,
    outside it (without, gen's program kept the file the run had written for another checkout)."""
    shutil.rmtree(fp, ignore_errors=True)
    d, h = os.path.dirname(os.path.dirname(fp)), fp[-16:]
    for f in glob.glob(f"{d}/build/*-{h}/output"):
        os.remove(f)
    found.append(f"{os.path.relpath(fp, t)}: {why}")

if mode == "all":
    ws = set(names)
    for fp in glob.glob(t + "/*/.fingerprint/*") + glob.glob(t + "/*/*/.fingerprint/*"):  # <profile>/, <triple>/<profile>/
        m = re.fullmatch(r"(.*)-[0-9a-f]{16}", os.path.basename(fp))
        if not m or m.group(1) not in ws:
            continue
        seen += 1
        k = set()
        if (why := tied(records(fp), k)):
            drop(fp, why)
        else:
            kept += [(os.path.relpath(fp, t), p, rel) for p, rel in sorted(k)]
else:
    try:
        lines = [l.split("\t") for l in open(t + "/.scenic-elsewhere").read().splitlines()]
    except OSError:
        lines = []
    for fp, p, rel in (l for l in lines if len(l) == 3):
        full = os.path.join(t, fp)
        if not os.path.isdir(full) or not any(p in (read(f) or "") for f in records(full)):
            continue  # (compiled again since: its record names this checkout's file)
        seen += 1
        if same(p, rel):
            kept.append((fp, p, rel))
        else:
            drop(full, f"it compiles in another checkout's {rel}, not this one's bytes")
with open(t + "/.scenic-elsewhere", "w") as f:
    f.write("".join("\t".join(x) + "\n" for x in kept))
with open(t + "/.scenic-tied", "w" if mode == "all" else "a") as f:
    f.write("".join(l + "\n" for l in sorted(found)))
print(f"{len(found)} of {seen}")
PY
  )
}
djreset=$EPOCHREALTIME
# (.scenic-built-by says "checksums <checkout>": a shim from before #1123 reads another checkout's
# name there whatever built last, and so deletes every workspace fingerprint, as it did; it can't
# see .scenic-elsewhere's units, whose other checkout's file cargo checks by time under it.)
if [[ $(cat $t/.scenic-built-by 2>/dev/null) != "checksums $top" ]]; then
  # The local packages' and their targets' names (- and _ forms): the workspace's, and a path
  # package outside it (crates/geos-src, by [patch]); the workspace's alone when the lock file
  # can't be read as it is without the network.
  names=( ${(f)"$({ $real metadata --format-version 1 --locked --offline 2>/dev/null ||
      $real metadata --no-deps --format-version 1 --offline 2>/dev/null } | python3 -c '
import json, sys
for p in json.load(sys.stdin)["packages"]:
    if p["source"] is None:
        for n in [p["name"]] + [t["name"] for t in p["targets"]]: print(n); print(n.replace("-", "_"))')"} )
  if (( ! $#names )); then print -u2 "cargo: could not list the workspace's crates"; exit 1; fi
  look all $names || { print -u2 "cargo: could not look at the workspace's units"; exit 1; }
  print -r -- "checksums $top" > $t/.scenic-built-by
  dj_span reset "the units tied to another checkout: $REPLY (another worktree built last)" $djreset $EPOCHREALTIME ok
  djgot=$EPOCHREALTIME
elif [[ -s $t/.scenic-elsewhere ]]; then
  look kept || { print -u2 "cargo: could not look at the workspace's units"; exit 1; }
  [[ $REPLY == 0\ * ]] || dj_span reset "the units tied to another checkout: $REPLY (compiling in its files)" $djreset $EPOCHREALTIME ok
  djgot=$EPOCHREALTIME
fi
# The checkout's tools (cmake for crates/geos-src) by PATH, not by mise's shims: build scripts run in
# the shared folder, outside the repo, where a shim finds no mise.toml.
whence mise >/dev/null && eval "$(mise env -C $top -s zsh 2>/dev/null)" 2>/dev/null
export CARGO_TARGET_DIR=$t SCENIC_CARGO_SHARED=1
# Fresh by content (#1123): cargo's -Z checksum-freshness (unstable in 1.98: cargo's channel taken for
# a nightly's, rustc given RUSTC_BOOTSTRAP by rustc-checksums for that flag's compiles alone), through
# the wrapper cargo's config names (sccache), which rustc-checksums runs.
cw=${self:h}/rustc-checksums
if [[ ${RUSTC_WRAPPER:-} != $cw ]]; then
  export SCENIC_RUSTC_WRAPPER=${RUSTC_WRAPPER:-${${$(__CARGO_TEST_CHANNEL_OVERRIDE_DO_NOT_USE_THIS=nightly $real -Zunstable-options config get --format json-value build.rustc-wrapper 2>/dev/null)#\"}%\"}}
fi
export RUSTC_WRAPPER=$cw __CARGO_TEST_CHANNEL_OVERRIDE_DO_NOT_USE_THIS=nightly CARGO_UNSTABLE_CHECKSUM_FRESHNESS=true

# A whole `cargo clean` deletes the shared folder itself, its lock and queue with it: every waiter
# then gave up, and a cargo starting meanwhile made a new lock to take while the clean still ran (two
# at once). So the shim empties the folder itself, its .scenic-* files kept (.scenic-runs: programs
# running from their clones). A clean of part (a package, profile, target, the docs) or of another
# folder, or a dry run, is cargo's.
if [[ $sub == clean ]] && (( ! ${own[(I)(-p*|--package(|=*)|--workspace|-r|--release|--profile(|=*)|--target(|=*)|--target-dir(|=*)|--doc|-n|--dry-run)]} )); then
  print -u2 -r -- "cargo clean (tools/dev/bin): emptying the shared build folder $t, every worktree's build (its .scenic-* files kept)"
  rm -rf -- $t/(^.scenic-*)(DN); exit
fi

# Which commands run programs: run, test, bench (and their aliases), nextest's run.
ri=0
case $sub in
  run|r|test|t|bench) ri=$si ;;
  nextest) for (( i = si + 1; i <= $#args; i++ )); do [[ $args[i] == [+-]* ]] || break; done
           [[ ${args[i]:-} == (run|r) ]] && ri=$i ;;
esac
# A test run from an agent worktree on a Mac that is not the test Mac: refused (#1398; the hook,
# tools/dev/test-guard.py, refuses the runs it can read, this one those it can't: a script, a function, a
# sub-shell). The test Mac, and the override, are tools/app/test-mac.zsh's (is_test_mac, tests_local). What runs
# tests here on purpose passes: check.sh's own parts build and lint, its tests go to the test Mac
# (remote-tests.sh runs them there, or here with SCENIC_CHECK_LOCAL=1), and publish.sh isn't in a worktree.
if (( inside )) && [[ $sub == (t|test|nextest) ]] && (( ri )); then
  source ${self:h:h:h}/app/test-mac.zsh
  if ! tests_local && ! is_test_mac; then
    print -u2 -r -- "cargo (tools/dev/bin): tests run on the test Mac ($(test_mac_name)), not on this Mac ($(this_mac)): run tools/dev/check.sh in your worktree, or tools/app/remote-tests.sh <a key of your own> <your worktree> 'cargo nextest run -p <crate> …'. SCENIC_TESTS_LOCAL=1 runs them here on purpose: only when the PM says the test Mac is away. See tools/dev/testing.md."
    exit 2
  fi
fi
(( ri )) || whole "$@"
host=$(rustc -vV 2>/dev/null | sed -n 's/^host: //p')
[[ -n $host ]] || whole "$@"
# This run's clones, in the shared folder (an APFS clone is a copy only on the same volume). A run
# leaves them (#1131): Gatekeeper scans a program's file after it starts, and syspolicyd crashed
# whenever the file was gone by then (38 times, 4-11 Nov; while it restarts no new process starts
# on the Mac, for up to minutes). Those of a run whose process is gone go RAN_KEEP_S after it was
# first seen gone (tools/dev/ran.zsh's ran_clean, the rule's for every program that ran); a folder
# of this shell's PID (a gone process's, the PID reused) is set aside under another name, kept
# while this shell lives and then cleaned as any.
source ${self:h:h}/ran.zsh
runs=$t/.scenic-runs
mkdir -p $runs && ran_clean $runs
r=$runs/$$; [[ -e $r ]] && mv $r $(mktemp -d $r.XXXXXX); mkdir -p $r/bin || exit 1
mode=record; [[ $sub == nextest ]] && mode=nextest
# (The runner: /bin/sh writes the environment to a file in $r, then starts this script on it.)
sh='m=$1 d=$2; shift 2; e=$(/usr/bin/mktemp "$d/env.XXXXXX") && /usr/bin/env -0 > "$e" && exec /bin/zsh "$0" "$m" "$d" "$e" "$@"'
args=( "${(@)args[1,ri]}" --config "target.$host.runner = [\"/bin/sh\", \"-c\", '$sh', \"$self\", \"--scenic-$mode\", \"$r\"]" "${(@)args[ri+1,-1]}" )
if [[ $mode == nextest ]]; then
  # Nextest builds, lists every binary (each cloned by the runner), then runs tests from the clones.
  spawn realcargo "${args[@]}"
  while kill -0 $child 2>/dev/null && [[ ! -e $r/started ]]; do zselect -t 20; done
  letgo
  # (The build until its first test; then the tests, nextest's run.)
  [[ -e $r/started ]] && { built 0; djnx=$EPOCHREALTIME }
  waitchild; rc=$?
  if [[ -n ${djnx:-} ]]; then
    st=ok; (( rc )) && st=fail; (( sig )) && st=stopped
    dj_span tests "nextest run" $djnx $EPOCHREALTIME $st exit $rc
  else built $rc; fi
  exit $rc
fi

spawn realcargo "${args[@]}"; waitchild; rc=$?
built $rc
stopped $rc
recs=( $r/*.cwd(N) ); recs=( ${recs%.cwd} )
if (( ! $#recs )); then exit $rc; fi
# As cargo: stop at the first failure unless --no-fail-fast; -q: no "Running" lines. (Only the
# options before `--`: after it they are the programs'.)
nff=${own[(I)--no-fail-fast]} quiet=$(( ${own[(I)-q]} + ${own[(I)--quiet]} ))
prog() {  # prog <record> <clone>: the program as cargo would start it
  local args vars
  readz $1.argv; args=( "${reply[@]}" )
  readz $1.env; vars=( "${reply[@]}" )
  # (Outside the lock a cargo it starts must take the lock again.)
  vars=( ${vars:#SCENIC_CARGO_(SHARED|HOLD)=*} )
  cd -- "$(<$1.cwd)" || return 1
  exec /usr/bin/env -i "${vars[@]}" $2 "${(@)args[2,-1]}"
}
binexe() {  # binexe <record>: its CARGO_BIN_EXE_* (cargo sets them as it runs a test too) name clones
  local i x vars; readz $1.env; vars=( "${reply[@]}" )
  for (( i = 1; i <= $#vars; i++ )); do
    [[ $vars[i] == CARGO_BIN_EXE_[^=]##=$t/* ]] || continue
    x=$(clone ${vars[i]#*=} $r/bin) || return 1; vars[i]=${vars[i]%%=*}=$x
  done
  print -rN -- "${vars[@]}" > $1.env
}
runprog() {  # runprog <record>: the program as a child (see fwd), its status
  local t0=$EPOCHREALTIME x st=ok n
  spawn prog $1 $cl[$1]; waitchild; x=$?
  # (Its run a span of the cargo's: a test or bench binary's a suite, a run's program a program.)
  n=$(exe $1); n=${${n:t}%-[0-9a-f](#c16)}
  (( x )) && st=fail; (( sig )) && st=stopped
  dj_span ${${${sub:#(r|run)}:+suite}:-program} $n $t0 $EPOCHREALTIME $st exit $x
  return $x
}
exe() { readz $1.argv; print -r -- $reply[1] }
started() { (( quiet )) || print -u2 -r -- "     Running ${$(exe $1)#$t/}" }
failed() { print -u2 -r -- "error: test failed: ${$(exe $1)#$t/} (exit $2)" }
# Clones first, under the lock: a run's program with the programs beside it (which it may start from
# its own folder), a test's with the programs its CARGO_BIN_EXE_* name.
typeset -A cl; first=0
for rec in $recs; do
  x=$(exe $rec)
  if [[ $sub == (run|r) ]]; then
    for p in ${x:h}/*(N.x); do [[ $p == $x ]] || clone $p $r/bin >/dev/null; done
  fi
  cl[$rec]=$(clone $x $r/bin) && binexe $rec || { print -u2 "cargo: could not clone $x into $r/bin"; exit 1; }
done
letgo
# Each a child, the last too, so its run is timed and its status known (a signal to this shell goes
# on to it, see fwd).
for rec in $recs; do
  started $rec
  runprog $rec; x=$?
  stopped $x
  if (( x )); then
    failed $rec $x; (( first )) || first=$x
    (( nff )) || break
  fi
done
(( first )) && exit $first
exit $rc
