<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleIdentifier</key>
	<string>local.scenic.status</string>
	<key>CFBundleName</key>
	<string>Scenic</string>
	<key>CFBundleDisplayName</key>
	<string>Scenic</string>
	<key>CFBundleExecutable</key>
	<string>scenic-status</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>1.0</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>CFBundleIconFile</key>
	<string>Scenic</string>
	<!-- No Dock icon: the menu bar item and the app's window only (main.swift also sets the
	     accessory activation policy). -->
	<key>LSUIElement</key>
	<true/>
	<key>LSMinimumSystemVersion</key>
	<string>26.0</string>
	<!-- What the app manages (tools/status/service.swift); tools/status/bundle.sh's sandbox build
	     names its own, and adds ScenicHome, ScenicRunDir and ScenicServer. -->
	<key>ScenicBuildService</key>
	<string>local.scenic.build</string>
	<key>ScenicServerLabel</key>
	<string>local.scenic.server</string>
	<key>ScenicUpdateFrom</key>
	<string>Scenic.app</string>
	<key>ScenicOpenAtLogin</key>
	<true/>
	<!-- The build page in the panel: the lead's coordinator over plain HTTP, at its Tailscale and
	     LAN addresses. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Scenic shows the build page from the Mac that leads the build.</string>
</dict>
</plist>
