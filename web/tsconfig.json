{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable", "WebWorker"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "types": ["vite/client", "geojson"],
    // Our own MapLibre (maplibre/, FORK.md), typed by its declarations: `npm run typecheck` writes
    // them (maplibre/tsconfig.app.json), checking its source under its own, looser settings.
    "paths": {
      "maplibre-gl": ["./maplibre/types/index.d.ts"]
    }
  },
  "include": ["src"]
}
